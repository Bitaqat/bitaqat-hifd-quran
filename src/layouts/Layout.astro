---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Kit gratuit et libre de cartes de récitation pour l'apprentissage et la mémorisation du Qor'an, avec une méthodologie pédagogique complète.",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Bitaqat Hifd Qor'an</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body class="bg-white text-ink-800 antialiased dark:bg-ink-950 dark:text-ink-100">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
