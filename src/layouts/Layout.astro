---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { dirs, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description = "Kit gratuit et libre de cartes de récitation pour l'apprentissage et la mémorisation du Qor'an, avec une méthodologie pédagogique complète.",
  lang = "fr",
} = Astro.props;

const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const rssHref = lang === "fr" ? "/rss.xml" : `/${lang}/rss.xml`;
---

<!doctype html>
<html lang={lang} dir={dirs[lang]} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script src="/scripts/theme-init.js" is:inline></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Bitaqat Hifd Qor'an</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="alternate" type="application/rss+xml" title="Bitaqat Hifd Qor'an" href={rssHref} />
    {beaconToken && (
      <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${beaconToken}"}`}></script>
    )}
  </head>
  <body class="bg-white text-ink-800 antialiased dark:bg-night-950 dark:text-night-100">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script src="/scripts/theme-toggle.js" defer></script>
    <script src="/scripts/newsletter.js" defer></script>
  </body>
</html>
