---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { paliers, categories, outils, methodologieDocs } from "../data/niveaux";

const images = import.meta.glob("../assets/cartes/*.png", { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;
function getImage(name: string) {
  const entry = Object.entries(images).find(([path]) => path.endsWith(`/${name}`));
  return entry?.[1].default;
}
---

<Layout
  title="Téléchargements"
  description="Toutes les cartes de récitation, les outils de suivi et les documents de méthodologie à télécharger gratuitement."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 sm:pt-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Ressources</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">Téléchargements</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-ink-300">
      L'ensemble de ce kit est distribué sous licence
      <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.fr" class="text-gold-600 hover:underline" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>
      : partage et adaptation libres, sous les conditions suivantes :
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-ink-600 dark:text-ink-300">
      <li>Le kit ne doit pas être commercialisé ni revendu, sous quelque forme que ce soit.</li>
      <li>
        Les cartes et documents doivent conserver la mention : <em>« Bitaqat Hifd Qor'an – bitaqat-hifd-quran.com »</em>,
        et indiquer clairement toute modification apportée.
      </li>
    </ul>
    <p class="mt-4 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
      Si ce kit ou l'une de ses cartes vous a été vendu, merci de nous le signaler via la page
      <a href="/contact" class="text-gold-600 hover:underline">contact</a>.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold text-ink-900 dark:text-white">Cartes de récitation</h2>
    {Object.entries(categories).map(([key, cat]) => {
      const items = paliers.filter((p) => p.categorie === key);
      if (items.length === 0) return null;
      return (
        <div class="mt-8">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">{cat.label}</h3>
          <div class="mt-3 divide-y divide-ink-100 rounded-2xl border border-ink-100 dark:divide-ink-800 dark:border-ink-800">
            {items.map((p) => {
              const recto = p.images ? getImage(p.images.recto) : null;
              return (
                <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-center gap-4">
                    {recto ? (
                      <Image
                        src={recto}
                        alt={`Aperçu — ${p.label}`}
                        width={112}
                        height={80}
                        class="h-20 w-28 shrink-0 rounded-lg border border-ink-100 object-contain bg-white p-1 dark:border-ink-800"
                      />
                    ) : (
                      <div class="flex h-20 w-28 shrink-0 items-center justify-center rounded-lg border border-dashed border-ink-200 text-ink-300 dark:border-ink-700 dark:text-ink-600">
                        <span class="text-xs">Pas d'aperçu</span>
                      </div>
                    )}
                    <div class="flex items-center gap-3">
                      <span class="h-3 w-3 shrink-0 rounded-full border border-ink-900/10 dark:border-white/20" style={`background-color:${p.couleur.hex}`}></span>
                      <div>
                        <p class="font-semibold text-ink-900 dark:text-white">{p.label}</p>
                        <p class="text-xs text-ink-500 dark:text-ink-400">{p.repere}</p>
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2 sm:pl-4">
                    {p.fichiers.map((f) => (
                      <a href={f.href} download class="js-track-download rounded-full border border-gold-300 px-4 py-1.5 text-xs font-semibold text-gold-700 transition-colors hover:bg-gold-500 hover:text-white dark:border-gold-700 dark:text-gold-400">
                        {f.label} <span class="download-count opacity-70"></span>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <h2 class="text-2xl font-bold text-ink-900 dark:text-white">Outils de suivi</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {outils.map((o) => (
        <a href={o.href} download class="js-track-download rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
          <p class="font-semibold text-ink-900 dark:text-white">{o.label} <span class="download-count text-xs font-normal text-ink-400"></span></p>
          <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">{o.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <h2 class="text-2xl font-bold text-ink-900 dark:text-white">Méthodologie</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {methodologieDocs.map((d) => (
        <a href={d.href} download class="js-track-download rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
          <p class="font-semibold text-ink-900 dark:text-white">{d.label} <span class="download-count text-xs font-normal text-ink-400"></span></p>
          <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">{d.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-ink-100 bg-gold-50 py-16 dark:border-ink-800 dark:bg-ink-900">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="text-xl font-bold text-ink-900 dark:text-white">Ce kit vous a été utile ?</h2>
      <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">
        Faites-nous en part via la page <a href="/contact" class="text-gold-600 hover:underline">contact</a> — vos retours nous aident à faire vivre ce projet.
      </p>
    </div>
  </section>

  <script src="/scripts/downloads.js" defer></script>
</Layout>
