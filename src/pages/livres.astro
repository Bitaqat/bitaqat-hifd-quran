---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { editions, amazonUrl } from "../data/livres";
import { routes } from "../i18n/ui";
import coverPuits from "../assets/livres/le-puits-des-etoiles.jpg";
import coverSceau from "../assets/livres/le-sceau-des-etoiles.jpg";

const r = routes.fr;

const books = [
  {
    badge: null,
    title: "Le Sceau des Étoiles",
    subtitle: "Six amis, un parchemin, une quête au cœur du Qor'an",
    cover: coverSceau,
    alt: "Couverture du Sceau des Étoiles : six enfants de dos contemplent une cité au crépuscule, sous un grand sceau lumineux.",
    blurb:
      "Six amis. Un parchemin oublié depuis cinq siècles. Six sceaux de cire gardant un trésor sans nom. Dans les galeries cachées de l'Alhambra, Qaïs et ses amis mettent la main sur une carte qui bouleverse leurs vies — et découvrent qu'aucune épreuve ne se franchit sans graver dans son cœur les mots les plus précieux du monde.",
    details: "Roman illustré · à partir de 10 ans · la quête qui a fait naître la série",
    edition: editions.sceau.fr,
  },
  {
    badge: "Nouveau",
    title: "Le Puits des Étoiles",
    subtitle: "Aux origines du Sceau des Étoiles",
    cover: coverPuits,
    alt: "Couverture du Puits des Étoiles : un jeune homme se penche au-dessus d'un puits de pierre dont le fond s'ouvre sur un ciel d'étoiles.",
    blurb:
      "Grenade, fin de l'an 1491. Dans un jardin en ruine, un jeune maître au cœur trop pressé se penche sur un puits sans eau — et le fond du puits s'ouvre sur un ciel d'étoiles. Voici l'histoire d'Idrîs, tombé mille ans dans le futur chez les derniers récitants des mondes, et des origines rêvées des cartes de récitation.",
    details: "Roman illustré (15 planches) · à partir de 10 ans · les sept versets d'Al-Fâtiha en colonne vertébrale",
    edition: editions.puits.fr,
  },
];
---

<Layout
  title="Les livres"
  description="Les romans de la série Le Sceau des Étoiles : Le Puits des Étoiles et Le Sceau des Étoiles, romans jeunesse illustrés autour des cartes de récitation, publiés au profit du projet."
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Les livres</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">
      La série du Sceau des Étoiles
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-600 dark:text-night-300">
      Deux romans jeunesse illustrés racontent l'aventure dont les cartes de récitation sont le trésor : une même
      chaîne, de la Grenade de 1491 aux six amis d'aujourd'hui. Chaque chapitre s'achève par un encart sourcé —
      versets et hadiths avec références complètes, en traductions approchées du sens — et une séparation explicite
      entre la part du vrai et la part du conte.
    </p>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-600 dark:text-night-300">
      Les deux livres se lisent dans l'ordre qu'on veut : les chemins se moquent de l'ordre où on les prend. Ils sont
      publiés au profit du projet — les cartes, elles, <a href={r.telechargements} class="font-medium text-gold-600 hover:underline">restent gratuites</a>.
    </p>

    <div class="mt-14 space-y-14">
      {books.map((book) => (
        <article class="grid gap-8 sm:grid-cols-[220px_1fr] sm:gap-10">
          <div class="mx-auto w-48 sm:w-auto">
            <Image
              src={book.cover}
              alt={book.alt}
              width={440}
              class="rounded-lg shadow-lg ring-1 ring-ink-900/10 dark:ring-white/10"
            />
          </div>
          <div>
            {book.badge && (
              <span class="inline-block rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
                {book.badge}
              </span>
            )}
            <h2 class="mt-2 text-2xl font-bold text-ink-900 dark:text-white">{book.title}</h2>
            <p class="mt-1 font-medium italic text-ink-500 dark:text-night-400">{book.subtitle}</p>
            <p class="mt-4 leading-relaxed text-ink-600 dark:text-night-300">{book.blurb}</p>
            <p class="mt-3 text-sm text-ink-500 dark:text-night-400">{book.details}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {amazonUrl(book.edition, "paperback") ? (
                <a
                  href={amazonUrl(book.edition, "paperback")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-ink-900 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-gold-600 dark:bg-white dark:text-ink-900"
                >
                  Livre broché — Amazon
                </a>
              ) : (
                <span class="rounded-full border border-ink-200 px-5 py-2 text-sm font-medium text-ink-400 dark:border-night-700 dark:text-night-500">
                  Broché bientôt disponible
                </span>
              )}
              {amazonUrl(book.edition, "ebook") ? (
                <a
                  href={amazonUrl(book.edition, "ebook")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-ink-300 px-5 py-2 text-sm font-semibold text-ink-700 transition-colors hover:border-gold-400 hover:text-gold-600 dark:border-night-600 dark:text-night-200"
                >
                  eBook Kindle — Amazon
                </a>
              ) : (
                <span class="rounded-full border border-ink-200 px-5 py-2 text-sm font-medium text-ink-400 dark:border-night-700 dark:text-night-500">
                  eBook bientôt disponible
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 rounded-xl bg-ink-50 p-6 text-sm leading-relaxed text-ink-600 dark:bg-night-900 dark:text-night-300">
      <p>
        La série existe aussi en anglais : <em>The Well of Stars</em> et <em>The Seal of Stars</em> — <a href={routes.en.livres} class="font-medium text-gold-600 hover:underline">voir la page anglaise</a>.
        Et à la dernière page de chaque roman, une invitation : prendre <a href={r.telechargements} class="font-medium text-gold-600 hover:underline">ta première carte</a>,
        écrire ton nom, et commencer par le commencement.
      </p>
    </div>
  </section>
</Layout>
