---
import Layout from "../layouts/Layout.astro";
import ProgressionPath from "../components/ProgressionPath.astro";
---

<Layout title="Accueil">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-gold-50 to-white dark:from-night-900 dark:to-night-950"></div>
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-16 text-center sm:pt-28 sm:pb-24">
      <p class="font-arabic text-2xl text-gold-600 sm:text-3xl">بطاقات حفظ القرآن الكريم</p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-6xl dark:text-white">
        Un chemin balisé vers la mémorisation du Qor'an
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-night-300">
        Un kit pédagogique libre et gratuit — cartes de récitation, méthodologie complète et outils de suivi — pour
        accompagner élèves, parents et professeurs, pas à pas, jusqu'à la maîtrise du dernier quart du Qor'an.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/telechargements"
          class="rounded-full bg-gold-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/25 transition-colors hover:bg-gold-600"
        >
          Télécharger le kit gratuitement
        </a>
        <a
          href="/methodologie"
          class="rounded-full border border-ink-200 px-7 py-3 text-sm font-semibold text-ink-700 transition-colors hover:border-gold-400 hover:text-gold-700 dark:border-night-700 dark:text-night-200"
        >
          Découvrir la méthodologie
        </a>
      </div>
    </div>
  </section>

  <!-- Progression -->
  <section class="border-y border-ink-100 bg-ink-50/60 py-16 dark:border-night-800 dark:bg-night-900/40">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-gold-600">Un parcours en niveaux</h2>
      <p class="mt-3 text-2xl font-bold text-ink-900 dark:text-white">6 niveaux, du hizb Sabbih à Yâcîn</p>
      <p class="mx-auto mt-3 max-w-xl text-ink-500 dark:text-night-400">
        Chaque niveau a sa couleur et son objectif. L'élève progresse à son rythme, avec une carte à présenter à
        chaque récitation.
      </p>
      <div class="mt-10">
        <ProgressionPath />
      </div>
      <a href="/methodologie/niveaux" class="mt-8 inline-block text-sm font-semibold text-gold-600 hover:underline">
        Voir le détail des niveaux →
      </a>
    </div>
  </section>

  <!-- 3 piliers -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-gold-600">Une pédagogie par objectifs</h2>
      <p class="mt-3 text-3xl font-bold text-ink-900 dark:text-white">Trois exigences, trois acteurs</p>
    </div>
    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {[
        {
          titre: "Apprentissage par objectif",
          texte: "Un objectif clair est fixé en début d'année, décomposé en étapes hebdomadaires et mensuelles à la maison.",
        },
        {
          titre: "Responsabilisation",
          texte: "Professeur, élève et parents partagent la charge de l'apprentissage, chacun avec un rôle précis.",
        },
        {
          titre: "Suivi",
          texte: "La carte de récitation matérialise la progression et facilite un suivi régulier, en classe et à la maison.",
        },
      ].map((item) => (
        <div class="rounded-2xl border border-ink-100 p-8 transition-shadow hover:shadow-lg dark:border-night-800">
          <h3 class="text-lg font-bold text-ink-900 dark:text-white">{item.titre}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-500 dark:text-night-400">{item.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-forest py-20 dark:bg-forest-dark">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white">Œuvre libre, non commercialisable</h2>
      <p class="mt-4 text-night-300">
        Le kit complet — cartes, méthodologie et outils de suivi — est disponible gratuitement au téléchargement,
        pour les écoles, mosquées, instituts et familles.
      </p>
      <a
        href="/telechargements"
        class="mt-8 inline-block rounded-full bg-gold-500 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/20 transition-colors hover:bg-gold-400"
      >
        Accéder aux téléchargements
      </a>
    </div>
  </section>
</Layout>
