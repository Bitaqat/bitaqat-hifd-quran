---
import Layout from "../../layouts/Layout.astro";
import ProgressionPath from "../../components/ProgressionPath.astro";
---

<Layout
  title="Home"
  lang="en"
  description="A free, open-licence kit of recitation cards for learning and memorizing the Qur'an, with a complete pedagogical methodology."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-gold-50 to-white dark:from-ink-900 dark:to-ink-950"></div>
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-16 text-center sm:pt-28 sm:pb-24">
      <p class="font-arabic text-2xl text-gold-600 sm:text-3xl">بطاقات حفظ القرآن الكريم</p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-6xl dark:text-white">
        A guided path towards memorizing the Qur'an
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
        A free, open-licence learning kit — recitation cards, a complete methodology and tracking tools — to
        support students, parents and teachers, step by step, up to mastering the last quarter of the Qur'an.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/en/downloads"
          class="rounded-full bg-gold-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/25 transition-colors hover:bg-gold-600"
        >
          Download the kit for free
        </a>
        <a
          href="/en/methodology"
          class="rounded-full border border-ink-200 px-7 py-3 text-sm font-semibold text-ink-700 transition-colors hover:border-gold-400 hover:text-gold-700 dark:border-ink-700 dark:text-ink-200"
        >
          Discover the methodology
        </a>
      </div>
    </div>
  </section>

  <!-- Progression -->
  <section class="border-y border-ink-100 bg-ink-50/60 py-16 dark:border-ink-800 dark:bg-ink-900/40">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-gold-600">A path made of levels</h2>
      <p class="mt-3 text-2xl font-bold text-ink-900 dark:text-white">6 levels, from hizb Sabbih to Yâsîn</p>
      <p class="mx-auto mt-3 max-w-xl text-ink-500 dark:text-ink-400">
        Each level has its own colour and goal. Students progress at their own pace, with a card to present at
        every recitation.
      </p>
      <div class="mt-10">
        <ProgressionPath lang="en" />
      </div>
      <a href="/en/methodology/levels" class="mt-8 inline-block text-sm font-semibold text-gold-600 hover:underline">
        See the levels in detail →
      </a>
    </div>
  </section>

  <!-- 3 pillars -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-gold-600">A goal-based pedagogy</h2>
      <p class="mt-3 text-3xl font-bold text-ink-900 dark:text-white">Three requirements, three roles</p>
    </div>
    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {[
        {
          titre: "Goal-based learning",
          texte: "A clear goal is set at the start of the year, broken down into weekly and monthly steps done at home.",
        },
        {
          titre: "Shared responsibility",
          texte: "Teacher, student and parents share the learning workload, each with a precise role.",
        },
        {
          titre: "Tracking",
          texte: "The recitation card makes progress visible and enables regular tracking, both in class and at home.",
        },
      ].map((item) => (
        <div class="rounded-2xl border border-ink-100 p-8 transition-shadow hover:shadow-lg dark:border-ink-800">
          <h3 class="text-lg font-bold text-ink-900 dark:text-white">{item.titre}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-500 dark:text-ink-400">{item.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-ink-900 py-20 dark:bg-black">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white">Free work, not for commercial use</h2>
      <p class="mt-4 text-ink-300">
        The full kit — cards, methodology and tracking tools — is freely available for download, for schools,
        mosques, institutes and families.
      </p>
      <a
        href="/en/downloads"
        class="mt-8 inline-block rounded-full bg-gold-500 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/20 transition-colors hover:bg-gold-400"
      >
        Go to downloads
      </a>
    </div>
  </section>
</Layout>
