---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { editions, amazonUrl } from "../../data/livres";
import { routes } from "../../i18n/ui";
import coverWell from "../../assets/livres/the-well-of-stars.jpg";
import coverSeal from "../../assets/livres/the-seal-of-stars.jpg";

const r = routes.en;

const books = [
  {
    badge: null,
    title: "The Seal of Stars",
    subtitle: "Six friends, a parchment, and a quest to the heart of the Qur'an",
    cover: coverSeal,
    alt: "Cover of The Seal of Stars: six children seen from behind gaze at a city at dusk, beneath a great luminous seal.",
    blurb:
      "Six friends. A parchment forgotten for five centuries. Six wax seals guarding a nameless treasure. In the hidden galleries of the Alhambra, Qais and his friends lay their hands on a map that overturns their lives — and discover that no trial can be overcome without first engraving on your heart the most precious words in the world.",
    details: "Illustrated novel · ages 10 and up · the quest that started the series",
    edition: editions.sceau.en,
  },
  {
    badge: "New",
    title: "The Well of Stars",
    subtitle: "Origins of the Seal of Stars",
    cover: coverWell,
    alt: "Cover of The Well of Stars: a young man leans over a stone well whose depths open onto a sky full of stars.",
    blurb:
      "Granada, late in the year 1491. In a ruined garden, a young master with too hurried a heart leans over a waterless well — and the bottom of the well opens onto a sky of stars. This is the story of Idris, fallen a thousand years into the future among the last reciters of the worlds, and of the dreamed origins of the recitation cards.",
    details: "Illustrated novel (15 plates) · ages 10 and up · the seven verses of Al-Fatiha as its backbone",
    edition: editions.puits.en,
  },
];
---

<Layout
  title="Books"
  description="The novels of the Seal of Stars series: The Well of Stars and The Seal of Stars, illustrated middle-grade novels built around the recitation cards, published in support of the project."
  lang="en"
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Books</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">
      The Seal of Stars series
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-600 dark:text-night-300">
      Two illustrated middle-grade novels tell the adventure whose treasure is the recitation cards: one unbroken
      chain, from the Granada of 1491 to six friends of today. Each chapter closes with a sourced panel — verses and
      hadiths with full references, in approximate renderings of the meaning — and a clear separation between the
      part that is true and the part that is tale.
    </p>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-600 dark:text-night-300">
      The two books can be read in either order: roads care nothing for the order in which we take them. They are
      published in support of the project — the cards themselves <a href={r.telechargements} class="font-medium text-gold-600 hover:underline">remain free</a>.
    </p>

    <div class="mt-14 space-y-14">
      {books.map((book) => (
        <article class="grid gap-8 sm:grid-cols-[220px_1fr] sm:gap-10">
          <div class="mx-auto w-48 sm:w-auto">
            <Image
              src={book.cover}
              alt={book.alt}
              width={440}
              class="rounded-lg shadow-lg ring-1 ring-ink-900/10 dark:ring-white/10"
            />
          </div>
          <div>
            {book.badge && (
              <span class="inline-block rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
                {book.badge}
              </span>
            )}
            <h2 class="mt-2 text-2xl font-bold text-ink-900 dark:text-white">{book.title}</h2>
            <p class="mt-1 font-medium italic text-ink-500 dark:text-night-400">{book.subtitle}</p>
            <p class="mt-4 leading-relaxed text-ink-600 dark:text-night-300">{book.blurb}</p>
            <p class="mt-3 text-sm text-ink-500 dark:text-night-400">{book.details}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {amazonUrl(book.edition, "paperback") ? (
                <a
                  href={amazonUrl(book.edition, "paperback")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-ink-900 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-gold-600 dark:bg-white dark:text-ink-900"
                >
                  Paperback — Amazon
                </a>
              ) : (
                <span class="rounded-full border border-ink-200 px-5 py-2 text-sm font-medium text-ink-400 dark:border-night-700 dark:text-night-500">
                  Paperback coming soon
                </span>
              )}
              {amazonUrl(book.edition, "ebook") ? (
                <a
                  href={amazonUrl(book.edition, "ebook")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-ink-300 px-5 py-2 text-sm font-semibold text-ink-700 transition-colors hover:border-gold-400 hover:text-gold-600 dark:border-night-600 dark:text-night-200"
                >
                  Kindle eBook — Amazon
                </a>
              ) : (
                <span class="rounded-full border border-ink-200 px-5 py-2 text-sm font-medium text-ink-400 dark:border-night-700 dark:text-night-500">
                  eBook coming soon
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 rounded-xl bg-ink-50 p-6 text-sm leading-relaxed text-ink-600 dark:bg-night-900 dark:text-night-300">
      <p>
        The series also exists in French: <em>Le Puits des Étoiles</em> and <em>Le Sceau des Étoiles</em> — <a href={routes.fr.livres} class="font-medium text-gold-600 hover:underline">see the French page</a>.
        And on the last page of each novel, an invitation: take <a href={r.telechargements} class="font-medium text-gold-600 hover:underline">your first card</a>,
        write your name, and begin at the beginning.
      </p>
    </div>
  </section>
</Layout>
