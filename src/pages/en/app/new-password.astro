---
/** English twin of /app/nouveau-mot-de-passe — see that file for why this page exists. */
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="New password"
  description="Return of the password reset link for an adult account of the Bitaqat Hifd Qor'an app."
  noindex
>
  <section class="mx-auto max-w-xl px-6 py-16 sm:py-24" data-mot-de-passe data-scheme="bitaqat://auth">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Application</p>

    <div data-etat="succes">
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">
        Choose your new password
      </h1>

      <div data-si="tactile" hidden>
        <div class="mt-8 space-y-4 text-sm leading-relaxed text-ink-600 dark:text-night-300">
          <p>
            The link is recognised. The <strong>Bitaqat Hifd Qor'an</strong> app is about to open
            on the screen where the new password is chosen.
          </p>
          <p class="text-ink-500 dark:text-night-400">
            If it does not open by itself, use the button below.
          </p>
        </div>
        <p class="mt-8">
          <a
            href="bitaqat://auth"
            data-vers-app
            hidden
            class="inline-block rounded-full bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-gold-600 dark:bg-white dark:text-ink-900 dark:hover:bg-gold-400"
          >
            Choose my password
          </a>
        </p>
      </div>

      <div data-si="ordinateur" hidden>
        <div class="mt-8 space-y-4 text-sm leading-relaxed text-ink-600 dark:text-night-300">
          <p>
            The new password is chosen inside the app, on the phone it is installed on — this page
            cannot do it in its place.
          </p>
          <p>
            This link was opened here, and a link works only once. Carry on from the phone: in the
            app, sign-in screen, “Forgotten your password?” — a new message will be waiting for you
            there.
          </p>
        </div>
      </div>
    </div>

    <div data-etat="echec" data-titre="Link expired · Bitaqat Hifd Qor'an" hidden>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">
        This link is no longer valid
      </h1>
      <div class="mt-8 space-y-4 text-sm leading-relaxed text-ink-600 dark:text-night-300">
        <p>
          A reset link expires after one hour, and works only once. This one has run out of time,
          or had already been used.
        </p>
        <p>
          Open the app again on your phone and ask for a new one from the sign-in screen,
          “Forgotten your password?”. Your current password has not changed.
        </p>
      </div>
      <p class="mt-8">
        <a
          href="/en/contact"
          class="inline-block rounded-full border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50 dark:border-night-700 dark:text-night-100 dark:hover:bg-night-900"
        >
          Write to us
        </a>
      </p>
    </div>
  </section>
</Layout>

<script src="/scripts/app-mot-de-passe.js" is:inline defer></script>
