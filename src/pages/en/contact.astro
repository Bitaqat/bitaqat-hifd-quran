---
import Layout from "../../layouts/Layout.astro";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Contact" lang="en" description="Get in touch with the Bitaqat Hifd Qor'an project.">
  <section class="mx-auto max-w-xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600 text-center">Contact</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white text-center">
      A question, a suggestion?
    </h1>
    <p class="mt-6 text-center leading-relaxed text-ink-600 dark:text-ink-300">
      Write to us using this form — feedback, questions about the methodology, reporting an issue, all welcome.
    </p>

    <form
      id="contact-form"
      class="mt-10 space-y-5"
      data-msg-missing-turnstile="Please complete the security check before sending."
      data-msg-sending="Sending…"
      data-msg-success="Message sent, thank you! We'll reply by email."
      data-msg-error="Something went wrong. Please try again shortly."
    >
      <div>
        <label for="name" class="block text-sm font-medium text-ink-700 dark:text-ink-200">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          class="mt-1 w-full rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-sm text-ink-900 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400 dark:border-ink-700 dark:bg-ink-900 dark:text-white"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-ink-700 dark:text-ink-200">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="200"
          class="mt-1 w-full rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-sm text-ink-900 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400 dark:border-ink-700 dark:bg-ink-900 dark:text-white"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-ink-700 dark:text-ink-200">Message</label>
        <textarea
          id="message"
          name="message"
          required
          maxlength="5000"
          rows="6"
          class="mt-1 w-full rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-sm text-ink-900 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400 dark:border-ink-700 dark:bg-ink-900 dark:text-white"
        ></textarea>
      </div>

      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>

      <button
        type="submit"
        id="contact-submit"
        class="w-full rounded-full bg-gold-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/20 transition-colors hover:bg-gold-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send
      </button>
      <p id="contact-status" role="status" class="text-center text-sm text-ink-500 dark:text-ink-400"></p>
    </form>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script src="/scripts/contact.js" defer></script>
</Layout>
