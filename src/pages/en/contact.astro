---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Contact" lang="en" description="Get in touch with the Bitaqat Hifd Qor'an project.">
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Contact</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">A form is coming soon</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-ink-300">
      The site's contact form is being set up. Check back soon to share your feedback, questions or suggestions
      about the recitation card kit.
    </p>
    <a href="/en/downloads" class="mt-10 inline-block rounded-full bg-gold-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/20 transition-colors hover:bg-gold-600">
      Browse the downloads in the meantime
    </a>
  </section>
</Layout>
