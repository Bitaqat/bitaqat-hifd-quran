---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import ResourceActions from "../../../components/ResourceActions.astro";
import suivi from "../../../assets/outils/en/carte-de-suivi.png";
---

<Layout
  title="Tracking card"
  lang="en"
  description="The tracking card records the student's recitation and behaviour at every session."
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Methodology</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">Tracking card</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-ink-300">
      The tracking card records the student's performance, both in recitation and behaviour, for every class
      session. It takes the form of a series of cells, each representing one session — ideally as many cells as
      there are recitation days in the year.
    </p>

    <Image src={suivi} alt="Recitation and behaviour tracking card" class="js-lightbox mt-10 w-full cursor-zoom-in rounded-2xl border border-ink-100 transition-opacity hover:opacity-90 dark:border-ink-800" />

    <h2 class="mt-12 text-lg font-bold text-ink-900 dark:text-white">A simple icon system</h2>
    <ul class="mt-4 space-y-3 text-sm text-ink-600 dark:text-ink-300">
      <li class="flex items-center gap-3"><span class="text-lg">✅</span> Recitation achieved</li>
      <li class="flex items-center gap-3"><span class="text-lg">❌</span> Recitation not achieved</li>
      <li class="flex items-center gap-3"><span class="text-lg">➡️</span> Not recited</li>
      <li class="flex items-center gap-3"><span class="text-lg">⚠️</span> Behaviour warning</li>
    </ul>
    <p class="mt-4 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
      A space for remarks is provided in every cell, for precise communication between teacher and parents.
    </p>

    <div class="mt-10">
      <ResourceActions href="/downloads/outils/en/fiche-suivi-comportement.pdf" label="Tracking sheet (PDF)" lang="en" />
    </div>
  </section>

  <script src="/scripts/downloads.js" defer></script>
  <script src="/scripts/lightbox.js" defer></script>
</Layout>
