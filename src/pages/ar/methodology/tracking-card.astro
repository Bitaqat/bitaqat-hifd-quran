---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import ResourceActions from "../../../components/ResourceActions.astro";
import suivi from "../../../assets/cartes/carte-de-suivi.png";
---

<Layout
  title="بطاقة المتابعة"
  lang="ar"
  description="بطاقة المتابعة تُسجّل تسميع الطالب وسلوكه في كل حصة."
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">المنهجية</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">بطاقة المتابعة</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-ink-300">
      تُسجّل بطاقة المتابعة أداء الطالب، في التسميع والسلوك معًا، في كل حصة دراسية. وتأخذ شكل سلسلة من الخانات،
      تمثّل كل خانة حصة واحدة — ويُستحسن أن يكون عدد الخانات مساويًا لعدد أيام التسميع في السنة.
    </p>

    <Image src={suivi} alt="بطاقة متابعة التسميع والسلوك" class="js-lightbox mt-10 w-full cursor-zoom-in rounded-2xl border border-ink-100 transition-opacity hover:opacity-90 dark:border-ink-800" />

    <h2 class="mt-12 text-lg font-bold text-ink-900 dark:text-white">نظام رموز بسيط</h2>
    <ul class="mt-4 space-y-3 text-sm text-ink-600 dark:text-ink-300">
      <li class="flex items-center gap-3"><span class="text-lg">✅</span> تسميع محقَّق</li>
      <li class="flex items-center gap-3"><span class="text-lg">❌</span> تسميع غير محقَّق</li>
      <li class="flex items-center gap-3"><span class="text-lg">➡️</span> لم يُسمَّع</li>
      <li class="flex items-center gap-3"><span class="text-lg">⚠️</span> تنبيه سلوكي</li>
    </ul>
    <p class="mt-4 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
      خُصِّصت مساحة للملاحظات في كل خانة، لتواصل دقيق بين المعلم والوالدين.
    </p>

    <div class="mt-10 flex items-center gap-2">
      <ResourceActions href="/downloads/outils/fiche-suivi-comportement.pdf" label="بطاقة المتابعة (PDF)" lang="ar" />
      <span class="text-xs text-ink-400">(بالفرنسية)</span>
    </div>
  </section>

  <script src="/scripts/downloads.js" defer></script>
  <script src="/scripts/lightbox.js" defer></script>
</Layout>
