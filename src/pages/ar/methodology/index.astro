---
import Layout from "../../../layouts/Layout.astro";
import { methodologieDocs } from "../../../data/niveaux.ar";
---

<Layout
  title="المنهجية"
  lang="ar"
  description="المنهجية التربوية لحقيبة بطاقات التسميع: تعلّم قائم على الأهداف، وتقاسم المسؤولية، والمتابعة."
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">المنهجية</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">
      منهجية صارمة، بُنيت لتدوم
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-ink-600 dark:text-ink-300">
      طموح هذه المنهجية هو تمكين حفظ الربع الأخير من القرآن الكريم عن ظهر قلب — من «سبّح» إلى «يس» — مع احترام
      أحكام التجويد، وفي الوقت نفسه منح الطالب استقلالية كاملة لمواصلة التعلّم.
    </p>
    <p class="mt-4 leading-relaxed text-ink-600 dark:text-ink-300">
      تقوم على تربية موجَّهة بالأهداف، وترتكز على ثلاثة شروط، يحملها ثلاثة أدوار: الطالب، والوالدان، والمعلم.
    </p>

    <div class="mt-12 space-y-10">
      <div id="objectif">
        <h2 class="text-xl font-bold text-ink-900 dark:text-white">تعلّم قائم على الأهداف</h2>
        <p class="mt-3 leading-relaxed text-ink-600 dark:text-ink-300">
          تحديد هدف في بداية السنة أمر مهم لتحقيق الفعالية. طوال السنة، ينبغي أن يعرف الجميع دائمًا «إلى أين
          يتجهون» و«أين هم الآن». يتم التعلّم عبر أهداف قصيرة تُنجَز في المنزل؛ أما التسميع والتصديق فيتمّان في
          الفصل، مع المعلم. وهكذا، تتراكم المكتسبات خطوة بخطوة، ويتم تثبيتها في الفصل.
        </p>
      </div>
      <div id="responsabilisation">
        <h2 class="text-xl font-bold text-ink-900 dark:text-white">تقاسم المسؤولية</h2>
        <p class="mt-3 leading-relaxed text-ink-600 dark:text-ink-300">
          يتحمّل الجميع مسؤوليتهم: يحدّد المعلم الأهداف، ويوجّه الطالب، ويتابع التقدّم، ويصادق على المكتسبات؛
          ويعمل الطالب على تحقيق الأهداف المطلوبة؛ ويساعد الوالدان، بالتعاون مع المعلم، الطالبَ على بلوغ أهدافه
          ويقومان بمتابعة يومية في المنزل. للوالدين دور محوري — إذ يتوقف نجاح الطالب إلى حد كبير عليهما.
        </p>
      </div>
      <div id="suivi">
        <h2 class="text-xl font-bold text-ink-900 dark:text-white">المتابعة</h2>
        <p class="mt-3 leading-relaxed text-ink-600 dark:text-ink-300">
          بما أن التعلّم يتم أساسًا في المنزل، فإن متابعة الوالدين أمر محوري. فهما يشاركان بشكل مباشر وشخصي في
          نجاح المشروع ويساهمان مباشرة في تحقيق إنجازات الطالب.
        </p>
      </div>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2">
      <a href="/ar/methodology/how-it-works" class="rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
        <h3 class="font-bold text-ink-900 dark:text-white">كيف تعمل البطاقات ←</h3>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">كيفية قراءة البطاقة والتصديق عليها، سورةً سورةً.</p>
      </a>
      <a href="/ar/methodology/levels" class="rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
        <h3 class="font-bold text-ink-900 dark:text-white">المستويات ←</h3>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">تفاصيل المستويات الستة، وألوانها، وأهدافها.</p>
      </a>
      <a href="/ar/methodology/tracking-card" class="rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
        <h3 class="font-bold text-ink-900 dark:text-white">بطاقة المتابعة ←</h3>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">أداة مكمّلة لمتابعة التسميع والسلوك.</p>
      </a>
      <a href="/ar/downloads" class="rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg dark:border-ink-800">
        <h3 class="font-bold text-ink-900 dark:text-white">التحميلات ←</h3>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">جميع البطاقات والأدوات، جاهزة للطباعة.</p>
      </a>
    </div>

    <div class="mt-16 rounded-2xl bg-ink-50 p-8 dark:bg-ink-900">
      <h3 class="font-bold text-ink-900 dark:text-white">وثائق مرجعية</h3>
      <p class="mt-2 text-xs text-ink-400">متوفرة حاليًا باللغة الفرنسية فقط — تُخطَّط ترجمة عربية لاحقًا. تواصل معنا إذا كنت بحاجة إليها عاجلًا.</p>
      <ul class="mt-4 space-y-3">
        {methodologieDocs.map((doc) => (
          <li>
            <a href={doc.href} class="font-medium text-gold-600 hover:underline" download>{doc.label} <span class="text-xs font-normal text-ink-400">(بالفرنسية)</span></a>
            <p class="text-sm text-ink-500 dark:text-ink-400">{doc.description}</p>
          </li>
        ))}
      </ul>
    </div>

    <blockquote class="mt-16 border-s-4 border-gold-400 ps-6 text-ink-600 italic dark:text-ink-300">
      «ما هذه إلا خطوة واحدة في رحلة حفظ القرآن الكريم وعلومه، الرحلة الشيّقة والمثمرة.»
    </blockquote>
  </section>
</Layout>
