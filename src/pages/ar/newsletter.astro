---
import Layout from "../../layouts/Layout.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { useTranslations, routes, type Lang } from "../../i18n/ui";

const lang: Lang = "ar";
const t = useTranslations(lang);
---

<Layout title={t("footer.newsletter")} description={t("newsletter.pageDesc")} lang={lang}>
  <section class="mx-auto max-w-xl px-6 py-16 sm:py-24">
    <div id="nl-confirmed" class="text-center" hidden>
      <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">{t("footer.newsletter")}</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink-900 dark:text-white sm:text-4xl">
        {t("newsletter.confirmedTitle")}
      </h1>
      <p class="mt-6 leading-relaxed text-ink-600 dark:text-night-300">{t("newsletter.confirmedBody")}</p>
      <a href={routes[lang].home} class="mt-8 inline-block text-sm font-semibold text-gold-600 hover:text-gold-700">
        {t("newsletter.backHome")}
      </a>
    </div>

    <div id="nl-unsub" class="text-center" hidden>
      <h1 class="text-3xl font-extrabold tracking-tight text-ink-900 dark:text-white sm:text-4xl">
        {t("newsletter.unsubTitle")}
      </h1>
      <form
        id="newsletter-unsub-form"
        data-msg-sending={t("newsletter.msgSending")}
        data-msg-error={t("newsletter.msgError")}
        class="mt-6"
      >
        <p class="leading-relaxed text-ink-600 dark:text-night-300">{t("newsletter.unsubBody")}</p>
        <button
          type="submit"
          class="mt-6 rounded-full border border-ink-300 px-7 py-3 text-sm font-semibold text-ink-700 transition-colors hover:border-ink-400 hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-night-700 dark:text-night-200 dark:hover:bg-night-900"
        >
          {t("newsletter.unsubButton")}
        </button>
        <p id="newsletter-unsub-status" role="status" class="mt-3 text-sm text-ink-500 dark:text-night-400"></p>
      </form>
      <div id="newsletter-unsub-done" hidden>
        <h2 class="text-xl font-bold text-ink-900 dark:text-white">{t("newsletter.unsubDoneTitle")}</h2>
        <p class="mt-3 leading-relaxed text-ink-600 dark:text-night-300">{t("newsletter.unsubDoneBody")}</p>
        <a href={routes[lang].home} class="mt-8 inline-block text-sm font-semibold text-gold-600 hover:text-gold-700">
          {t("newsletter.backHome")}
        </a>
      </div>
    </div>

    <div id="nl-signup">
      <p
        id="nl-invalid"
        class="mb-8 rounded-lg border border-gold-200 bg-gold-50 px-5 py-4 text-sm leading-relaxed text-gold-800 dark:border-gold-800 dark:bg-gold-900/20 dark:text-gold-200"
        hidden
      >
        <strong class="font-semibold">{t("newsletter.invalidTitle")}</strong><br />{t("newsletter.invalidBody")}
      </p>
      <NewsletterForm lang={lang} id="newsletter-page" headingLevel="h1" />
    </div>
  </section>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var unsubToken = params.get("u");
      var signup = document.getElementById("nl-signup");

      if (params.get("confirmed")) {
        signup.hidden = true;
        document.getElementById("nl-confirmed").hidden = false;
      } else if (unsubToken && /^[0-9a-f]{64}$/.test(unsubToken)) {
        signup.hidden = true;
        document.getElementById("newsletter-unsub-form").dataset.token = unsubToken;
        document.getElementById("nl-unsub").hidden = false;
      } else if (params.get("invalid")) {
        document.getElementById("nl-invalid").hidden = false;
      }
    })();
  </script>
</Layout>
