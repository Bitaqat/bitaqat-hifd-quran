---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import ResourceActions from "../../components/ResourceActions.astro";
import { paliers, categories, outils, methodologieDocs } from "../../data/niveaux.ar";
import type { ThemeVariant } from "../../data/niveaux";
import { useTranslations } from "../../i18n/ui";

const t = useTranslations("ar");
const THEMES: ThemeVariant[] = ["clair", "nuit"];

const images = import.meta.glob("../../assets/cartes/ar/*.png", { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;
function getImage(name: string) {
  const entry = Object.entries(images).find(([path]) => path.endsWith(`/${name}`));
  return entry?.[1].default;
}

const outilsImages = import.meta.glob("../../assets/outils/ar/*.png", { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;
function getOutilImage(name: string) {
  const entry = Object.entries(outilsImages).find(([path]) => path.endsWith(`/${name}`));
  return entry?.[1].default;
}

const methodologieImages = import.meta.glob("../../assets/methodologie/ar/*.png", { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;
function getMethodologieImage(name: string) {
  const entry = Object.entries(methodologieImages).find(([path]) => path.endsWith(`/${name}`));
  return entry?.[1].default;
}
---

<Layout
  title="التحميلات"
  lang="ar"
  description="جميع بطاقات التسميع، وأدوات المتابعة، ووثائق المنهجية، متاحة مجانًا للتحميل."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 sm:pt-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">الموارد</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">التحميلات</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-night-300">
      توزَّع الحقيبة بأكملها بموجب ترخيص
      <a href="https://creativecommons.org/licenses/by-nc/4.0/" class="text-gold-600 hover:underline" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>
      : مشاركة وتعديل حرّان، وفق الشروط التالية:
    </p>
    <ul class="mt-4 list-disc space-y-2 ps-5 text-sm text-ink-600 dark:text-night-300">
      <li>يُمنع بيع الحقيبة أو استغلالها تجاريًا بأي شكل من الأشكال.</li>
      <li>
        يجب أن تحافظ البطاقات والوثائق على الإشارة: <em>«Bitaqat Hifd Qor'an – bitaqat-hifd-quran.com»</em>،
        مع الإشارة بوضوح إلى أي تعديلات أُجريت.
      </li>
    </ul>
    <p class="mt-4 text-sm leading-relaxed text-ink-500 dark:text-night-400">
      إذا بيعت لك هذه الحقيبة أو إحدى بطاقاتها، يُرجى إعلامنا عبر
      <a href="/ar/contact" class="text-gold-600 hover:underline">صفحة التواصل</a>.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">بطاقات التسميع</h2>
      <label class="flex items-center gap-2 text-sm font-medium text-ink-600 dark:text-night-300">
        {t("downloads.theme")}
        <select class="js-theme-select rounded-lg border border-ink-200 bg-white px-3 py-1.5 text-sm text-ink-900 focus:border-gold-400 focus:outline-none dark:border-night-700 dark:bg-night-900 dark:text-white">
          <option value="clair">{t("downloads.themeClair")}</option>
          <option value="nuit">{t("downloads.themeNuit")}</option>
        </select>
      </label>
    </div>
    {Object.entries(categories).map(([key, cat]) => {
      const items = paliers.filter((p) => p.categorie === key);
      if (items.length === 0) return null;
      return (
        <div class="mt-8">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">{cat.label}</h3>
          <div class="mt-3 divide-y divide-ink-100 rounded-2xl border border-ink-100 dark:divide-night-800 dark:border-night-800">
            {items.map((p) => {
              const hasRiwaya = p.fichiers.some((f) => f.riwaya);
              return (
                <div
                  class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:justify-between"
                  data-riwaya-group={hasRiwaya ? p.id : undefined}
                >
                  <div class="flex flex-1 items-start gap-4">
                    <div class="flex shrink-0 gap-1.5">
                      {p.fichiers.map((f) =>
                        THEMES.map((theme) => {
                          const isDefault = theme === "clair" && (!f.riwaya || f.riwaya === "hafs");
                          const recto = getImage(f.imagesByTheme[theme].recto);
                          const verso = getImage(f.imagesByTheme[theme].verso);
                          return (
                            <>
                              {recto && (
                                <Image
                                  src={recto}
                                  alt={`${t("downloads.recto")} — ${p.label}`}
                                  width={800}
                                  height={577}
                                  data-theme-variant={theme}
                                  data-riwaya={f.riwaya}
                                  hidden={!isDefault}
                                  class="js-lightbox h-16 w-[90px] cursor-zoom-in rounded border border-ink-100 object-contain bg-white p-0.5 transition-opacity hover:opacity-80 dark:border-night-800"
                                />
                              )}
                              {verso && (
                                <Image
                                  src={verso}
                                  alt={`${t("downloads.verso")} — ${p.label}`}
                                  width={800}
                                  height={577}
                                  data-theme-variant={theme}
                                  data-riwaya={f.riwaya}
                                  hidden={!isDefault}
                                  class="js-lightbox h-16 w-[90px] cursor-zoom-in rounded border border-ink-100 object-contain bg-white p-0.5 transition-opacity hover:opacity-80 dark:border-night-800"
                                />
                              )}
                            </>
                          );
                        })
                      )}
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="h-3 w-3 shrink-0 rounded-full border border-ink-900/10 dark:border-white/20" style={`background-color:${p.couleur.hex}`}></span>
                      <div>
                        <p class="font-semibold text-ink-900 dark:text-white">{p.label}</p>
                        <p class="text-xs text-ink-500 dark:text-night-400">{p.repere}</p>
                        {hasRiwaya && (
                          <div class="mt-2 inline-flex overflow-hidden rounded-full border border-gold-300 text-xs font-semibold text-gold-700 dark:border-gold-700 dark:text-gold-400">
                            <button type="button" data-riwaya-btn="hafs" aria-pressed="true" class="px-2.5 py-1 transition-colors aria-pressed:bg-gold-500 aria-pressed:text-white">
                              {t("downloads.riwayaHafs")}
                            </button>
                            <button type="button" data-riwaya-btn="warsh" aria-pressed="false" class="border-s border-gold-300 px-2.5 py-1 transition-colors aria-pressed:bg-gold-500 aria-pressed:text-white dark:border-gold-700">
                              {t("downloads.riwayaWarsh")}
                            </button>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2 sm:ps-4">
                    {p.fichiers.map((f) =>
                      THEMES.map((theme) => {
                        const isDefault = theme === "clair" && (!f.riwaya || f.riwaya === "hafs");
                        return (
                          <span data-theme-variant={theme} data-riwaya={f.riwaya} hidden={!isDefault}>
                            <ResourceActions href={f.hrefByTheme[theme]} label={f.label} lang="ar" />
                          </span>
                        );
                      })
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <h2 class="text-2xl font-bold text-ink-900 dark:text-white">أدوات المتابعة</h2>
    <div class="mt-3 divide-y divide-ink-100 rounded-2xl border border-ink-100 dark:divide-night-800 dark:border-night-800">
      {outils.map((o) => (
        <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            {THEMES.map((theme) => {
              const preview = getOutilImage(o.imageByTheme[theme]);
              const isDefault = theme === "clair";
              return preview ? (
                <Image
                  src={preview}
                  alt={`معاينة — ${o.label}`}
                  width={800}
                  data-theme-variant={theme}
                  hidden={!isDefault}
                  class="js-lightbox h-20 w-28 shrink-0 cursor-zoom-in rounded-lg border border-ink-100 object-contain bg-white p-1 transition-opacity hover:opacity-80 dark:border-night-800"
                />
              ) : null;
            })}
            <div>
              <p class="font-semibold text-ink-900 dark:text-white">{o.label}</p>
              <p class="text-xs text-ink-500 dark:text-night-400">{o.description}</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 sm:ps-4">
            {THEMES.map((theme) => (
              <span data-theme-variant={theme} hidden={theme !== "clair"}>
                <ResourceActions href={o.hrefByTheme[theme]} label="PDF" lang="ar" />
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <h2 class="text-2xl font-bold text-ink-900 dark:text-white">المنهجية</h2>
    <div class="mt-3 divide-y divide-ink-100 rounded-2xl border border-ink-100 dark:divide-night-800 dark:border-night-800">
      {methodologieDocs.map((d) => {
        const preview = getMethodologieImage(d.image);
        return (
          <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              {preview ? (
                <Image
                  src={preview}
                  alt={`معاينة — ${d.label}`}
                  width={800}
                  class="js-lightbox h-20 w-28 shrink-0 cursor-zoom-in rounded-lg border border-ink-100 object-contain bg-white p-1 transition-opacity hover:opacity-80 dark:border-night-800"
                />
              ) : (
                <div class="flex h-20 w-28 shrink-0 items-center justify-center rounded-lg border border-dashed border-ink-200 text-ink-300 dark:border-night-700 dark:text-night-600">
                  <span class="text-xs">لا توجد معاينة</span>
                </div>
              )}
              <div>
                <p class="font-semibold text-ink-900 dark:text-white">{d.label}</p>
                <p class="text-xs text-ink-500 dark:text-night-400">{d.description}</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 sm:ps-4">
              <ResourceActions href={d.href} label={d.href.endsWith(".pptx") ? "PPTX" : "PDF"} lang="ar" />
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="border-t border-ink-100 bg-gold-50 py-16 dark:border-night-800 dark:bg-night-900">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="text-xl font-bold text-ink-900 dark:text-white">هل أفادتك هذه الحقيبة؟</h2>
      <p class="mt-3 text-sm text-ink-600 dark:text-night-300">
        أخبرنا عبر <a href="/ar/contact" class="text-gold-600 hover:underline">صفحة التواصل</a> — ملاحظاتكم تساعدنا في استمرار هذا المشروع.
      </p>
    </div>
  </section>

  <script src="/scripts/downloads.js" defer></script>
  <script src="/scripts/lightbox.js" defer></script>
  <script src="/scripts/resource-variants.js" defer></script>
</Layout>
