---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Contacter l'équipe du projet Bitaqat Hifd Qor'an.">
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Contact</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">Un formulaire arrive bientôt</h1>
    <p class="mt-6 leading-relaxed text-ink-600 dark:text-ink-300">
      Le formulaire de contact du site est en cours de mise en place. Revenez prochainement pour nous faire part de
      vos retours, questions ou suggestions sur le kit de cartes de récitation.
    </p>
    <a href="/telechargements" class="mt-10 inline-block rounded-full bg-gold-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-gold-500/20 transition-colors hover:bg-gold-600">
      Découvrir les téléchargements en attendant
    </a>
  </section>
</Layout>
