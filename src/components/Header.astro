---
import { useTranslations, languages, routes, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];

const nav = [
  { href: r.methodologie, label: t("nav.methodologie") },
  { href: r.niveaux, label: t("nav.niveaux") },
  { href: r.telechargements, label: t("nav.telechargements") },
  { href: r.contact, label: t("nav.contact") },
];

const otherLangs = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-100 bg-white/90 backdrop-blur dark:border-ink-800 dark:bg-ink-950/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={r.home} class="flex items-center gap-2 text-lg font-bold text-ink-900 dark:text-white">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-500 font-arabic text-white">ب</span>
      <span>Bitaqat Hifd Qor'an</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`text-sm font-medium transition-colors hover:text-gold-600 ${
            path === item.href ? "text-gold-600" : "text-ink-600 dark:text-ink-300"
          }`}
        >
          {item.label}
        </a>
      ))}
      <span class="flex items-center gap-3 text-sm font-medium text-ink-400">
        {otherLangs.map((l) => (
          <a href={routes[l].home} class="transition-colors hover:text-gold-600" hreflang={l}>
            {languages[l]}
          </a>
        ))}
      </span>
    </nav>
    <a
      href={r.telechargements}
      class="hidden rounded-full bg-ink-900 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-gold-600 md:inline-block dark:bg-white dark:text-ink-900"
    >
      {t("nav.cta")}
    </a>
    <details class="md:hidden">
      <summary class="list-none cursor-pointer rounded-md p-2 text-ink-700 dark:text-ink-200" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-ink-100 bg-white p-4 shadow-lg dark:border-ink-800 dark:bg-ink-950">
        {nav.map((item) => (
          <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-800">
            {item.label}
          </a>
        ))}
        <div class="flex gap-4 px-3 py-2">
          {otherLangs.map((l) => (
            <a href={routes[l].home} class="text-sm font-medium text-ink-700 hover:text-gold-600 dark:text-ink-200">
              {languages[l]}
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</header>
