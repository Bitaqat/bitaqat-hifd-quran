---
import { useTranslations, routes, type Lang } from "../i18n/ui";
import { getArticles, formatDate } from "../lib/news";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const articles = await getArticles(lang);
const base = routes[lang].actualites;
const rssHref = lang === "fr" ? "/rss.xml" : `/${lang}/rss.xml`;
---

<section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
  <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">{t("news.title")}</p>
  <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink-900 dark:text-white">{t("news.title")}</h1>
  <p class="mt-6 leading-relaxed text-ink-600 dark:text-night-300">{t("news.desc")}</p>

  <a
    href={rssHref}
    class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-gold-600 hover:text-gold-700"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
      <circle cx="6.18" cy="17.82" r="2.18" />
      <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
    </svg>
    {t("news.rss")}
  </a>

  {articles.length === 0 ? (
    <p class="mt-12 text-ink-500 dark:text-night-400">{t("news.empty")}</p>
  ) : (
    <ul class="mt-12 space-y-10">
      {articles.map((article) => (
        <li class="border-t border-ink-100 pt-8 dark:border-night-800">
          <time datetime={article.entry.data.pubDate.toISOString()} class="text-sm text-ink-400 dark:text-night-500">
            {formatDate(article.entry.data.pubDate, lang)}
          </time>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink-900 dark:text-white">
            <a href={`${base}/${article.slug}`} class="hover:text-gold-600">{article.entry.data.title}</a>
          </h2>
          <p class="mt-3 leading-relaxed text-ink-600 dark:text-night-300">{article.entry.data.description}</p>
          <a
            href={`${base}/${article.slug}`}
            class="mt-4 inline-block text-sm font-semibold text-gold-600 hover:text-gold-700"
          >
            {t("news.readMore")}
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
