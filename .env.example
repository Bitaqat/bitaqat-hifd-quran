# Copy this file to .env and fill in the values for local builds.
# On Cloudflare, set the same variable under Workers & Pages > Settings > Environment Variables,
# so it's available at build time in CI.

# Cloudflare Web Analytics site token (Analytics & Logs > Web Analytics > Manage site).
# Public by design (it ends up in the page HTML) but kept out of the repo so it's not
# hardcoded in source control.
PUBLIC_CF_BEACON_TOKEN=

# Turnstile site key for the contact form and the newsletter signup
# (Turnstile > your widget > Site Key).
# Public by design. The matching Secret Key is NOT here: it's set as a Worker
# secret (TURNSTILE_SECRET_KEY) via the Cloudflare dashboard, never in this repo.
PUBLIC_TURNSTILE_SITE_KEY=

# Newsletter sending goes through Resend. The API key is a Worker secret, NOT a build-time
# variable, so it does not belong in this file — it is listed here only as a reminder:
#
#   wrangler secret put RESEND_API_KEY
#
# The sending domain (bitaqat-hifd-quran.com) must be verified in the Resend dashboard
# first. Resend puts its SPF and return path on the `send` subdomain, so the root SPF
# record used by Email Routing is left alone — there is nothing to merge.
#
# Triggering a broadcast requires a second Worker secret, likewise not a build-time
# variable:
#
#   wrangler secret put NEWSLETTER_ADMIN_SECRET
#
# Generate it with `openssl rand -hex 32`. Without it the broadcast endpoint refuses
# every caller, so a missing secret fails closed rather than open.
